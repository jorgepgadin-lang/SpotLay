<UserControl x:Class="SpotLay.App.Views.ColorPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SpotLay.App.Infrastructure">
    <Border Background="{DynamicResource SL.Surface}" BorderBrush="{DynamicResource SL.Stroke}" BorderThickness="1" CornerRadius="8">
    <StackPanel Margin="18">
        <StackPanel Orientation="Horizontal">
            <!-- Saturación (horizontal) y brillo (vertical) del tono elegido. -->
            <Grid x:Name="SvArea" Width="240" Height="170" Cursor="Cross" ClipToBounds="True"
                  MouseLeftButtonDown="Sv_Down" MouseMove="Sv_Move" MouseLeftButtonUp="Area_Up">
                <Rectangle x:Name="HueFill" RadiusX="6" RadiusY="6" />
                <Rectangle RadiusX="6" RadiusY="6">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="White" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle RadiusX="6" RadiusY="6">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="Black" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
            <!-- Tono. -->
            <Grid x:Name="HueArea" Width="22" Height="170" Margin="12,0,0,0" Cursor="Hand"
                  MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move" MouseLeftButtonUp="Area_Up">
                <Rectangle RadiusX="5" RadiusY="5">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF0000" Offset="0" />
                            <GradientStop Color="#FFFF00" Offset="0.1667" />
                            <GradientStop Color="#00FF00" Offset="0.3333" />
                            <GradientStop Color="#00FFFF" Offset="0.5" />
                            <GradientStop Color="#0000FF" Offset="0.6667" />
                            <GradientStop Color="#FF00FF" Offset="0.8333" />
                            <GradientStop Color="#FF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="HueThumb" Width="26" Height="6" Canvas.Left="-2" CornerRadius="3"
                            BorderBrush="White" BorderThickness="2" />
                </Canvas>
            </Grid>
        </StackPanel>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="PreviewSwatch" Width="44" Height="32" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource SL.Stroke}" />
            <TextBox x:Name="HexBox" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                     ToolTip="{l:T 'Código del color (#RRGGBB)'}" LostFocus="Hex_Commit" KeyDown="Hex_KeyDown" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:T 'Aceptar'}" Style="{StaticResource SL.AccentButton}" MinWidth="90" Click="Ok_Click" />
            <Button Content="{l:T 'Cancelar'}" Style="{StaticResource SL.SubtleButton}" MinWidth="90" Margin="8,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
    </Border>
</UserControl>
