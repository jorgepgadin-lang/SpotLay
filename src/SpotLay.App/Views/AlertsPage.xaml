<UserControl x:Class="SpotLay.App.Views.AlertsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SpotLay.App.Infrastructure"
             xmlns:vm="clr-namespace:SpotLay.App.ViewModels"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource SL.Card}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource SL.Stroke}" BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SL.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Threshold" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="64" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,0,36,32">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Aviso legal -->
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{DynamicResource SL.Bad}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SL.Bad}" FontSize="12.5">
                    <Run Text="⚠ " FontWeight="Bold" /><Run Text="{l:T 'Uso bajo tu exclusiva responsabilidad. El apagado de emergencia actúa directamente sobre el hardware. SpotLay se ofrece «tal cual», sin garantía de ningún tipo, expresa o implícita, incluidas las de funcionamiento, idoneidad o ausencia de errores. Los autores no serán responsables de daños en el equipo, pérdida de datos, sobrecalentamiento, apagados inesperados ni de ningún otro perjuicio directo o indirecto derivado de su uso o de su mal funcionamiento, en la máxima medida permitida por la ley aplicable. Si no aceptas estas condiciones, no actives esta función.'}" />
                </TextBlock>
            </Border>

            <!-- Apagado de emergencia -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T 'Apagado de emergencia'}" Style="{StaticResource SL.SectionTitle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource SL.TextTertiary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShutdownLevel}" Value="ok"><Setter Property="Fill" Value="{DynamicResource SL.Good}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ShutdownLevel}" Value="warn"><Setter Property="Fill" Value="{DynamicResource SL.Warn}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ShutdownLevel}" Value="bad"><Setter Property="Fill" Value="{DynamicResource SL.Bad}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ShutdownStatus}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SL.Caption}" Margin="18,4,0,0">
                                <Run Text="{Binding ArmedCount, Mode=OneWay}" /><Run Text="{l:T ' sensor(es) con apagado. Si uno pasa su límite, SpotLay cuenta atrás y pide a Windows un apagado ordenado.'}" />
                            </TextBlock>
                            <TextBlock Text="{Binding LastEvent}" Style="{StaticResource SL.Caption}" Margin="18,2,0,0"
                                       Visibility="{Binding LastEvent, Converter={StaticResource StringToVis}}" />
                            <TextBlock Text="{l:T 'Modo prueba activo (--simular-apagado): la cuenta atrás nunca apaga Windows.'}" Foreground="{DynamicResource SL.Warn}"
                                       Style="{StaticResource SL.Caption}" Margin="18,2,0,0" Visibility="{Binding DryRun, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="{l:T 'Cancelar apagado'}" Command="{Binding CancelCommand}" Style="{StaticResource SL.AccentButton}"
                                    Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0" />
                            <Button Content="{l:T 'Probar cuenta atrás (no apaga)'}" Command="{Binding SimulateCommand}" Style="{StaticResource SL.SubtleButton}"
                                    ToolTip="{l:T 'Enseña la ventana de apagado 10 segundos y activa la tecla de cancelar. Windows no se apaga.'}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{l:T 'Cancelar con'}" Style="{StaticResource SL.Body}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Style="{StaticResource SL.Pill}" Padding="14,5" MinWidth="120">
                                <TextBlock Text="{Binding HotkeyText}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Border>
                            <Button Content="{l:T 'Cambiar'}" Command="{Binding CaptureHotkeyCommand}" Style="{StaticResource SL.SubtleButton}" Margin="10,0,0,0"
                                    Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}" />
                            <Button Content="{l:T 'Sin tecla'}" Command="{Binding DisableHotkeyCommand}" Style="{StaticResource SL.SubtleButton}" Margin="6,0,0,0"
                                    Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" Margin="24,0,0,0" Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{l:T 'Pausa tras cancelar'}" Style="{StaticResource SL.Body}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Style="{StaticResource Threshold}" Text="{Binding CooldownSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="s" Style="{StaticResource SL.Body}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource SL.Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Sensores -->
            <Border Style="{StaticResource Section}" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{l:T 'Sensores'}" Style="{StaticResource SL.SectionTitle}" />
                            <TextBlock Style="{StaticResource SL.Caption}" Margin="0,4,0,0"
                                       Text="{l:T 'Aviso: una ventana encima del juego y el valor en rojo en el overlay. Apagado: cuenta atrás y apagado de Windows. Los límites valen para todos los juegos.'}" />
                        </StackPanel>
                    </Grid>

                    <!-- Añadir sensor (Avanzado) -->
                    <Grid Margin="0,12,0,0" Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding AddableSensors}" SelectedValuePath="Key" DisplayMemberPath="Label"
                                  SelectedValue="{Binding SensorToAdd, Mode=TwoWay}" IsTextSearchEnabled="True" MinHeight="32"
                                  ToolTip="{l:T 'Cualquier sensor del equipo: temperaturas, consumos, RPM, uso…'}" />
                        <Button Grid.Column="1" Content="{l:T 'Añadir sensor'}" Command="{Binding AddSensorCommand}" Style="{StaticResource SL.SubtleButton}" Margin="10,0,0,0" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AlarmRowViewModel}">
                                <Border BorderBrush="{DynamicResource SL.Stroke}" BorderThickness="0,1,0,0" Padding="0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="200" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource SL.Bad}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                             Visibility="{Binding IsAlerting, Converter={StaticResource BoolToVis}}" ToolTip="{l:T 'En aviso ahora mismo'}" />
                                                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Value}" FontSize="14" Margin="10,0,0,0" Foreground="{DynamicResource SL.TextSecondary}"
                                                               Typography.NumeralAlignment="Tabular" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Device}" Style="{StaticResource SL.Caption}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <CheckBox Content="{l:T 'Aviso'}" IsChecked="{Binding AlertEnabled, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,8,0" />
                                                <TextBox Style="{StaticResource Threshold}" Text="{Binding AlertThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="{l:T 'Límite del aviso'}" />
                                                <TextBlock Text="{Binding Unit}" Style="{StaticResource SL.Body}" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="26" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                                <CheckBox Content="{l:T 'Apagado'}" IsChecked="{Binding ShutdownEnabled, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,8,0" />
                                                <TextBox Style="{StaticResource Threshold}" Text="{Binding ShutdownThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="{l:T 'Límite del apagado de emergencia'}" />
                                                <TextBlock Text="{Binding Unit}" Style="{StaticResource SL.Body}" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="26" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                                <Button Content="{l:T 'Probar aviso'}" Command="{Binding TestCommand}" Style="{StaticResource SL.SubtleButton}"
                                                        ToolTip="{l:T 'Enseña la ventana de aviso 5 segundos'}" />
                                                <Button Content="{l:T 'Opciones'}" Command="{Binding ToggleExpandCommand}" Style="{StaticResource SL.SubtleButton}" Margin="6,0,0,0"
                                                        Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}" />
                                                <Button Content="&#xE74D;" Command="{Binding RemoveCommand}" Style="{StaticResource SL.IconButton}" Margin="6,0,0,0"
                                                        ToolTip="{l:T 'Quitar este sensor'}" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisInverse}}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource SL.Caption}" Margin="0,4,0,0" />

                                        <!-- Opciones avanzadas -->
                                        <Border Margin="0,12,0,0" Padding="16" CornerRadius="8" Background="{DynamicResource SL.SurfaceAlt}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsAdvanced}" Value="True" />
                                                                <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Aviso: cuándo -->
                                                <StackPanel>
                                                    <TextBlock Text="{l:T 'AVISO'}" Style="{StaticResource SL.Eyebrow}" />
                                                    <CheckBox Content="{l:T 'Avisar por debajo del límite (en vez de por encima)'}" IsChecked="{Binding AlertBelow, Mode=TwoWay}" Margin="0,10,0,0" />
                                                    <StackPanel Style="{StaticResource Field}" Orientation="Horizontal">
                                                        <TextBlock Text="{l:T 'Histéresis'}" Style="{StaticResource SL.Body}" VerticalAlignment="Center" Width="120" />
                                                        <TextBox Style="{StaticResource Threshold}" Text="{Binding AlertHysteresis, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 ToolTip="{l:T 'Cuánto tiene que volver el valor para quitar el aviso (evita parpadeos)'}" />
                                                        <TextBlock Text="{Binding Unit}" Style="{StaticResource SL.Body}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                    <CheckBox Content="{l:T 'Ventana de aviso encima del juego'}" IsChecked="{Binding AlertPopup, Mode=TwoWay}" Margin="0,12,0,0" />
                                                    <StackPanel Style="{StaticResource Field}">
                                                        <TextBlock Text="{l:T 'Texto del aviso (vacío = nombre del sensor)'}" Style="{StaticResource SL.Label}" />
                                                        <TextBox Text="{Binding AlertText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource Field}">
                                                        <TextBlock Text="{l:T 'Posición'}" Style="{StaticResource SL.Label}" />
                                                        <ComboBox ItemsSource="{Binding DataContext.PositionOptions, ElementName=Root}" SelectedValuePath="Key" DisplayMemberPath="Label"
                                                                  SelectedValue="{Binding AlertPosition, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsCustomPosition, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{l:T 'Horizontal / vertical (%)'}" Style="{StaticResource SL.Label}" />
                                                        <Slider Minimum="0" Maximum="100" Value="{Binding AlertPositionX, Mode=TwoWay}" />
                                                        <Slider Minimum="0" Maximum="100" Value="{Binding AlertPositionY, Mode=TwoWay}" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Aviso: aspecto -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{l:T 'ASPECTO DEL AVISO'}" Style="{StaticResource SL.Eyebrow}" />
                                                    <StackPanel Style="{StaticResource Field}">
                                                        <TextBlock Text="{l:T 'Fondo'}" Style="{StaticResource SL.Label}" />
                                                        <Grid>
                                                            <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource SL.Stroke}"
                                                                    Background="{Binding AlertBackground, Converter={StaticResource HexToBrush}}" />
                                                            <TextBox Margin="40,0,0,0" Text="{Binding AlertBackground, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{x:Static vm:AlertsViewModel.PaletteColors}" Tag="{Binding}" Margin="0,8,0,0">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource Swatch}" Background="{Binding Converter={StaticResource HexToBrush}}" ToolTip="{Binding}"
                                                                            Command="{Binding Tag.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding Converter={StaticResource ColorParam}, ConverterParameter=bg}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource Field}">
                                                        <TextBlock Text="{l:T 'Texto'}" Style="{StaticResource SL.Label}" />
                                                        <Grid>
                                                            <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource SL.Stroke}"
                                                                    Background="{Binding AlertTextColor, Converter={StaticResource HexToBrush}}" />
                                                            <TextBox Margin="40,0,0,0" Text="{Binding AlertTextColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{x:Static vm:AlertsViewModel.PaletteColors}" Tag="{Binding}" Margin="0,8,0,0">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource Swatch}" Background="{Binding Converter={StaticResource HexToBrush}}" ToolTip="{Binding}"
                                                                            Command="{Binding Tag.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding Converter={StaticResource ColorParam}, ConverterParameter=text}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource Field}">
                                                        <Grid>
                                                            <TextBlock Text="{l:T 'Tamaño del nombre / del valor'}" Style="{StaticResource SL.Label}" />
                                                            <TextBlock Style="{StaticResource SL.Caption}" HorizontalAlignment="Right">
                                                                <Run Text="{Binding AlertLabelSize, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding AlertValueSize, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </Grid>
                                                        <Slider Minimum="10" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding AlertLabelSize, Mode=TwoWay}" />
                                                        <Slider Minimum="16" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding AlertValueSize, Mode=TwoWay}" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Overlay y apagado -->
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="{l:T 'EN EL OVERLAY'}" Style="{StaticResource SL.Eyebrow}" />
                                                    <StackPanel Style="{StaticResource Field}">
                                                        <TextBlock Text="{l:T 'Color del valor durante el aviso'}" Style="{StaticResource SL.Label}" />
                                                        <Grid>
                                                            <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource SL.Stroke}"
                                                                    Background="{Binding AlertTileColor, Converter={StaticResource HexToBrush}}" />
                                                            <TextBox Margin="40,0,0,0" Text="{Binding AlertTileColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{x:Static vm:AlertsViewModel.PaletteColors}" Tag="{Binding}" Margin="0,8,0,0">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource Swatch}" Background="{Binding Converter={StaticResource HexToBrush}}" ToolTip="{Binding}"
                                                                            Command="{Binding Tag.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding Converter={StaticResource ColorParam}, ConverterParameter=tile}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource Field}">
                                                        <Grid>
                                                            <TextBlock Text="{l:T 'Tamaño del valor durante el aviso'}" Style="{StaticResource SL.Label}" />
                                                            <TextBlock Style="{StaticResource SL.Caption}" HorizontalAlignment="Right">
                                                                <Run Text="{Binding AlertTileScale, Mode=OneWay}" /><Run Text=" %" />
                                                            </TextBlock>
                                                        </Grid>
                                                        <Slider Minimum="100" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding AlertTileScale, Mode=TwoWay}" />
                                                    </StackPanel>

                                                    <TextBlock Text="{l:T 'APAGADO'}" Style="{StaticResource SL.Eyebrow}" Margin="0,20,0,0" />
                                                    <CheckBox Content="{l:T 'Apagar por debajo del límite'}" IsChecked="{Binding ShutdownBelow, Mode=TwoWay}" Margin="0,10,0,0" />
                                                    <StackPanel Style="{StaticResource Field}" Orientation="Horizontal">
                                                        <TextBlock Text="{l:T 'Cuenta atrás'}" Style="{StaticResource SL.Body}" VerticalAlignment="Center" Width="120" />
                                                        <TextBox Style="{StaticResource Threshold}" Text="{Binding ShutdownDelaySeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                        <TextBlock Text="s" Style="{StaticResource SL.Body}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource Field}" Orientation="Horizontal">
                                                        <TextBlock Text="{l:T 'Histéresis'}" Style="{StaticResource SL.Body}" VerticalAlignment="Center" Width="120" />
                                                        <TextBox Style="{StaticResource Threshold}" Text="{Binding ShutdownHysteresis, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                        <TextBlock Text="{Binding Unit}" Style="{StaticResource SL.Body}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                    <CheckBox IsChecked="{Binding ShutdownAutoCancel, Mode=TwoWay}" Margin="0,12,0,0">
                                                        <TextBlock Text="{l:T 'Cancelar solo si el sensor vuelve a un valor seguro'}" TextWrapping="Wrap" />
                                                    </CheckBox>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Aspecto común (Avanzado) -->
            <Border Style="{StaticResource Section}" Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Ventana de aviso'}" Style="{StaticResource SL.SectionTitle}" />
                    <TextBlock Text="{l:T 'Tamaño y aspecto comunes a todos los avisos.'}" Style="{StaticResource SL.Caption}" Margin="0,4,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <Grid>
                                    <TextBlock Text="{l:T 'Ancho'}" Style="{StaticResource SL.Label}" />
                                    <TextBlock Text="{Binding WindowWidth}" Style="{StaticResource SL.Caption}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Minimum="220" Maximum="1200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding WindowWidth, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <Grid>
                                    <TextBlock Text="{l:T 'Alto'}" Style="{StaticResource SL.Label}" />
                                    <TextBlock Text="{Binding WindowHeight}" Style="{StaticResource SL.Caption}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Minimum="90" Maximum="500" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding WindowHeight, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <StackPanel Style="{StaticResource Field}">
                                <Grid>
                                    <TextBlock Text="{l:T 'Opacidad'}" Style="{StaticResource SL.Label}" />
                                    <TextBlock Style="{StaticResource SL.Caption}" HorizontalAlignment="Right"><Run Text="{Binding WindowOpacity, Mode=OneWay}" /><Run Text=" %" /></TextBlock>
                                </Grid>
                                <Slider Minimum="20" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding WindowOpacity, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <Grid>
                                    <TextBlock Text="{l:T 'Esquinas'}" Style="{StaticResource SL.Label}" />
                                    <TextBlock Text="{Binding WindowRadius}" Style="{StaticResource SL.Caption}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding WindowRadius, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
