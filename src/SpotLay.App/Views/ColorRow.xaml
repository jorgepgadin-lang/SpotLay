<UserControl x:Class="SpotLay.App.Views.ColorRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SpotLay.App.Infrastructure"
             xmlns:vm="clr-namespace:SpotLay.App.ViewModels"
             xmlns:local="clr-namespace:SpotLay.App.Views">
    <UserControl.Resources>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="B" CornerRadius="5" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource SL.Stroke}" BorderThickness="1" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SL.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <WrapPanel VerticalAlignment="Center">
        <!-- Color que se ve ahora en el overlay. -->
        <Border x:Name="CurrentSwatch" Width="30" Height="30" Margin="0,0,12,0" CornerRadius="6" VerticalAlignment="Center"
                BorderThickness="1" BorderBrush="{DynamicResource SL.TextTertiary}" />
        <ItemsControl x:Name="Palette" ItemsSource="{x:Static vm:OverlayEditorViewModel.PaletteColors}" VerticalAlignment="Center" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource Swatch}" Tag="{Binding}" ToolTip="{Binding}"
                            Background="{Binding Converter={StaticResource HexToBrush}}" Click="Swatch_Click" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="CustomButton" Style="{StaticResource Swatch}" Background="{DynamicResource SL.SurfaceAlt}" VerticalAlignment="Center"
                ToolTip="{l:T 'Elegir cualquier color…'}" Click="Custom_Click">
            <TextBlock Text="+" FontSize="15" FontWeight="SemiBold" Margin="0,-2,0,0" Foreground="{DynamicResource SL.Text}" />
        </Button>
        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=CustomButton}" Placement="Bottom" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="Popup_Closed">
            <local:ColorPickerPanel x:Name="Picker" Margin="0,0,8,8" />
        </Popup>
    </WrapPanel>
</UserControl>
