<UserControl x:Class="SpotLay.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SpotLay.App.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource SL.Card}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="Option" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,0,36,32">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Idioma'}" Style="{StaticResource SL.SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Key" DisplayMemberPath="Label"
                                  SelectedValue="{Binding Language, Mode=TwoWay}" MinWidth="200" />
                        <Button Content="{Binding RestartText}" Style="{StaticResource SL.AccentButton}" Command="{Binding RestartCommand}"
                                Margin="12,0,0,0" Visibility="{Binding LanguageNeedsRestart, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding RestartHint}" Style="{StaticResource SL.Caption}" Margin="0,8,0,0"
                               Visibility="{Binding LanguageNeedsRestart, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Actualizaciones'}" Style="{StaticResource SL.SectionTitle}" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource SL.Caption}" Margin="0,4,0,0" />
                    <CheckBox Content="{l:T 'Buscar actualizaciones automáticamente'}" IsChecked="{Binding AutoUpdate, Mode=TwoWay}" Margin="0,12,0,0" />
                    <TextBlock Text="{l:T 'Al arrancar y cada 6 horas mira en GitHub si hay versión nueva. Cada descarga se comprueba con su huella SHA-256.'}"
                               Style="{StaticResource SL.Caption}" TextWrapping="Wrap" Margin="28,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{l:T 'Buscar ahora'}" Style="{StaticResource SL.SubtleButton}" Command="{Binding CheckUpdatesCommand}" />
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource SL.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Apariencia'}" Style="{StaticResource SL.SectionTitle}" />
                    <Border Style="{StaticResource SL.SegmentHost}" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{l:T 'Como Windows'}" GroupName="Theme" Style="{StaticResource SL.Segment}" IsChecked="{Binding ThemeSystem, Mode=TwoWay}" />
                            <RadioButton Content="{l:T 'Claro'}" GroupName="Theme" Style="{StaticResource SL.Segment}" IsChecked="{Binding ThemeLight, Mode=TwoWay}" />
                            <RadioButton Content="{l:T 'Oscuro'}" GroupName="Theme" Style="{StaticResource SL.Segment}" IsChecked="{Binding ThemeDark, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Overlay'}" Style="{StaticResource SL.SectionTitle}" />
                    <CheckBox Style="{StaticResource Option}" IsChecked="{Binding OverlayEnabled, Mode=TwoWay}">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="{l:T 'Overlay activado'}" FontWeight="SemiBold" Foreground="{DynamicResource SL.Text}" />
                            <TextBlock Text="{l:T 'Apagado, SpotLay sigue midiendo pero no pinta nada encima de los juegos.'}" Style="{StaticResource SL.Caption}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Option}" IsChecked="{Binding ShowOnlyInGames, Mode=TwoWay}">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="{l:T 'Mostrar solo en juegos'}" FontWeight="SemiBold" Foreground="{DynamicResource SL.Text}" />
                            <TextBlock Style="{StaticResource SL.Caption}"
                                       Text="{l:T 'Aparece solo cuando la app en primer plano envía frames y está a pantalla completa o lleva Reflex. En cualquier otra app puedes forzarlo con el atajo.'}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Option}" IsChecked="{Binding HideGameMetricsWithoutGame, Mode=TwoWay}">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="{l:T 'Ocultar FPS y Frame Generation cuando no hay datos'}" FontWeight="SemiBold" Foreground="{DynamicResource SL.Text}" />
                            <TextBlock Text="{l:T 'Sin juego, o en Vulkan (sin FPS reales), esas tarjetas desaparecen en vez de mostrar «—».'}" Style="{StaticResource SL.Caption}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Inicio con Windows'}" Style="{StaticResource SL.SectionTitle}" />
                    <CheckBox Style="{StaticResource Option}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="{l:T 'Arrancar SpotLay con Windows'}" FontWeight="SemiBold" Foreground="{DynamicResource SL.Text}" />
                            <TextBlock Style="{StaticResource SL.Caption}" TextWrapping="Wrap"
                                       Text="{l:T 'Recomendado si usas los ventiladores o el apagado de emergencia: solo funcionan con SpotLay abierto.'}" />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Text="{Binding StartupMessage}" Style="{StaticResource SL.Caption}" Foreground="{DynamicResource SL.Good}" Margin="0,8,0,0"
                               Visibility="{Binding StartupMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Todas las teclas'}" Style="{StaticResource SL.SectionTitle}" />
                    <TextBlock Text="{l:T 'Las de los diseños se cambian en Inicio; la de cancelar el apagado, en Alertas.'}" Style="{StaticResource SL.Caption}" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding Shortcuts}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Action}" Style="{StaticResource SL.Body}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Keys}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Where}" Style="{StaticResource SL.Caption}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Status}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SL.Caption}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Conflict}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SL.Bad}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Atajo de teclado'}" Style="{StaticResource SL.SectionTitle}" />
                    <TextBlock Text="{l:T 'Muestra u oculta el overlay desde cualquier juego.'}" Style="{StaticResource SL.Caption}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Style="{StaticResource SL.Pill}" Padding="14,6" MinWidth="160">
                            <TextBlock Text="{Binding HotkeyText}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Border>
                        <Button Content="{l:T 'Cambiar'}" Command="{Binding CaptureHotkeyCommand}" Style="{StaticResource SL.SubtleButton}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource SL.Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Datos y diagnóstico'}" Style="{StaticResource SL.SectionTitle}" />
                    <TextBlock Style="{StaticResource SL.Caption}" Margin="0,4,0,0">
                        <Run Text="{l:T 'Captura de frames:'}" /> <Run Text="{Binding CaptureStatus, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource SL.Caption}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{l:T 'Abrir carpeta de datos'}" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource SL.SubtleButton}" />
                        <Button Content="{l:T 'Abrir registro'}" Command="{Binding OpenLogCommand}" Style="{StaticResource SL.SubtleButton}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Version}" Style="{StaticResource SL.Caption}" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
