<UserControl x:Class="SpotLay.App.Views.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SpotLay.App.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,0,36,32">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <Border Style="{StaticResource SL.Card}" Margin="0,0,0,16">
                <Grid>
                    <StackPanel Margin="0,0,260,0">
                        <TextBlock Text="{l:T 'Perfil para el juego abierto'}" Style="{StaticResource SL.SectionTitle}" />
                        <TextBlock Style="{StaticResource SL.Body}" Margin="0,4,0,0"
                                   Text="{l:T 'Copia el diseño global como punto de partida y luego cámbialo solo para ese juego.'}" />
                    </StackPanel>
                    <Button Content="{Binding CreateText}" Command="{Binding CreateForCurrentGameCommand}"
                            Style="{StaticResource SL.AccentButton}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Buscar, importar y limpiar -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" MinHeight="34" VerticalContentAlignment="Center" />
                    <TextBlock Text="{l:T 'Buscar perfil…'}" IsHitTestVisible="False" Style="{StaticResource SL.Caption}" FontSize="13"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding Search, Converter={StaticResource StringToVisInverse}}" />
                </Grid>
                <Button Grid.Column="1" Content="{l:T 'Importar diseño…'}" Style="{StaticResource SL.SubtleButton}" Margin="10,0,0,0"
                        Click="OpenImportMenu" ToolTip="{l:T 'Carga un archivo .spotlay.json y elige dónde ponerlo'}">
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding ImportTargets}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Label}" />
                                    <Setter Property="Command" Value="{Binding DataContext.ImportToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Grid.Column="2" Content="{l:T 'Quitar perfiles sin uso…'}" Command="{Binding ToggleCleanupCommand}" Style="{StaticResource SL.SubtleButton}"
                        Margin="10,0,0,0" ToolTip="{l:T 'Perfiles que SpotLay no ha detectado como juego (programas que no son juegos)'}" />
            </Grid>
            <TextBlock Text="{Binding Message}" Style="{StaticResource SL.Caption}" Foreground="{DynamicResource SL.Good}" Margin="0,0,0,10"
                       Visibility="{Binding Message, Converter={StaticResource StringToVis}}" />

            <Border Style="{StaticResource SL.Card}" Margin="0,0,0,12" Visibility="{Binding ShowCleanup, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Perfiles que SpotLay no ha visto como juego'}" Style="{StaticResource SL.SectionTitle}" />
                    <TextBlock Style="{StaticResource SL.Caption}" Margin="0,4,0,8" TextWrapping="Wrap"
                               Text="{l:T 'SpotLay 12 apunta cuándo detecta cada juego. Los que no se han detectado todavía salen aquí (también juegos que aún no has abierto desde que usas esta versión): marca solo los que sepas que no son juegos.'}" />
                    <ItemsControl ItemsSource="{Binding Cleanup}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,18,6" MinWidth="200">
                                    <TextBlock Text="{Binding Key}" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{l:T 'Borrar los marcados'}" Command="{Binding DeleteCheckedCommand}" Style="{StaticResource SL.SubtleButton}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding View}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SL.Card}" Padding="18,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SL.Caption}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="{l:T 'Activo'}" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,16,0" VerticalAlignment="Center"
                                              Visibility="{Binding IsGlobal, Converter={StaticResource BoolToVisInverse}}" />
                                    <Button Content="{l:T 'Editar'}" Command="{Binding EditCommand}" Style="{StaticResource SL.SubtleButton}" />
                                    <Button Content="{l:T 'Copiar a…'}" Style="{StaticResource SL.SubtleButton}" Margin="8,0,0,0"
                                            Click="OpenCopyMenu" ToolTip="{l:T 'Copia este diseño a otro juego o al global'}">
                                        <Button.ContextMenu>
                                            <ContextMenu ItemsSource="{Binding CopyTargets}">
                                                <ContextMenu.ItemContainerStyle>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Header" Value="{Binding Label}" />
                                                        <Setter Property="Command" Value="{Binding DataContext.CopyToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                                    </Style>
                                                </ContextMenu.ItemContainerStyle>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button Content="{l:T 'Exportar'}" Command="{Binding ExportCommand}" Style="{StaticResource SL.SubtleButton}" Margin="8,0,0,0"
                                            ToolTip="{l:T 'Guarda este diseño en un archivo para pasarlo o hacer copia'}" />
                                    <Button Content="{l:T 'Copiar global'}" Command="{Binding ResetCommand}" Style="{StaticResource SL.SubtleButton}" Margin="8,0,0,0"
                                            ToolTip="{l:T 'Sustituye este perfil por una copia del diseño global'}"
                                            Visibility="{Binding IsGlobal, Converter={StaticResource BoolToVisInverse}}" />
                                    <Button Content="&#xE74D;" Command="{Binding DeleteCommand}" Style="{StaticResource SL.IconButton}" Margin="8,0,0,0"
                                            ToolTip="{l:T 'Borrar perfil'}" Visibility="{Binding IsGlobal, Converter={StaticResource BoolToVisInverse}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
