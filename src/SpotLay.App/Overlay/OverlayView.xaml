<UserControl x:Class="SpotLay.App.Overlay.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ov="clr-namespace:SpotLay.App.Overlay"
             xmlns:infra="clr-namespace:SpotLay.App.Infrastructure"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="Grayscale">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:StringToVisibilityConverter x:Key="StringToVisibility" />
    </UserControl.Resources>

    <StackPanel>
    <!-- Rótulo al cambiar de diseño con una tecla (1,5 s). -->
    <Border Background="#E60B0D12" BorderBrush="#FF7C8CFF" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,0,6"
            HorizontalAlignment="Left" Visibility="{Binding Banner, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding Banner}" Foreground="White" FontSize="14" FontWeight="SemiBold" />
    </Border>
    <Grid>
    <!-- Editando: fondo casi invisible (alfa 1/255) solo para poder agarrarlo con el ratón también por
         las zonas vacías; la opacidad que se ve es la real del diseño. -->
    <Border Background="#01000000" CornerRadius="{Binding CornerRadius}"
            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
    <Border Background="{Binding Background}"
            CornerRadius="{Binding CornerRadius}"
            Padding="{Binding Padding}"
            TextElement.FontFamily="{Binding FontFamily}"
            Visibility="{Binding HasVisibleTiles, Converter={StaticResource BoolToVisibility}}">
        <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ov:TilePanel Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type ov:OverlayTileViewModel}">
                    <Border Width="{Binding Width}" Margin="{Binding Margin}" Padding="2,4" CornerRadius="6">
                        <!-- Transparente (no nulo) para poder agarrarla con Ctrl + ratón al editar. -->
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLifted}" Value="True">
                                        <Setter Property="Background" Value="#557C8CFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding Label}"
                                       FontSize="{Binding LabelSize}"
                                       Foreground="{Binding LabelBrush}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <Grid Height="{Binding VisualHeight}" Width="{Binding VisualWidth}" Margin="0,3,0,0"
                                  HorizontalAlignment="Center"
                                  Visibility="{Binding HasVisual, Converter={StaticResource BoolToVisibility}}">
                                <ov:GaugeElement Mode="{Binding Visualization}"
                                                 Fraction="{Binding Fraction}"
                                                 Fill="{Binding ValueBrush}"
                                                 Track="{Binding TrackBrush}"
                                                 Thickness="{Binding Thickness}"
                                                 History="{Binding History}" />
                                <!-- En arco y anillo la cifra va en el centro del grafico. -->
                                <StackPanel Orientation="{Binding UnitOrientation}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="{Binding ValueInsideMargin}"
                                            Visibility="{Binding ValueInside, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ValueText}" FontSize="{Binding DisplayValueSize}" FontWeight="{Binding ValueWeight}"
                                               Foreground="{Binding ValueBrush}" Effect="{Binding ValueEffect}"
                                               HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="{Binding Unit}" FontSize="{Binding DisplayUnitSize}" Foreground="{Binding UnitBrush}"
                                               Margin="{Binding UnitMargin}" HorizontalAlignment="{Binding UnitAlignment}"
                                               VerticalAlignment="{Binding UnitVerticalAlignment}"
                                               Visibility="{Binding ShowUnit, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="{Binding UnitOrientation}" HorizontalAlignment="Center" Margin="0,1,0,0"
                                        Visibility="{Binding ShowValueRow, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ValueText}" FontSize="{Binding ValueSize}" FontWeight="{Binding ValueWeight}"
                                           Foreground="{Binding ValueBrush}" Effect="{Binding ValueEffect}"
                                           HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="{Binding Unit}" FontSize="{Binding UnitSize}" Foreground="{Binding UnitBrush}"
                                           Margin="{Binding UnitMargin}" HorizontalAlignment="{Binding UnitAlignment}"
                                           VerticalAlignment="{Binding UnitVerticalAlignment}"
                                           Visibility="{Binding ShowUnit, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
    <!-- Marco mientras se mueve con Ctrl + Mayús + flechas o se edita en SpotLay (no cambia el tamaño). -->
    <Rectangle Stroke="#FF7C8CFF" StrokeThickness="2" StrokeDashArray="3 2" IsHitTestVisible="False"
               RadiusX="{Binding CornerRadius.TopLeft}" RadiusY="{Binding CornerRadius.TopLeft}"
               Visibility="{Binding ShowFrame, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
    </StackPanel>
</UserControl>
