<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="SL.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SL.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="SL.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="SL.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SL.DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SL.Text}" />
    </Style>

    <Style x:Key="SL.PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource SL.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SL.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SL.DisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SL.Text}" />
    </Style>

    <Style x:Key="SL.Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SL.TextTertiary}" />
    </Style>

    <Style x:Key="SL.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SL.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="SL.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SL.Text}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="SL.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SL.TextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SL.BigNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SL.DisplayFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SL.Text}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="SL.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SL.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SL.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="SL.Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SL.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SL.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="SL.NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource SL.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Back" CornerRadius="6" Background="Transparent" Padding="12,9" />
                        <Border x:Name="Marker" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{DynamicResource SL.Accent}" Visibility="Collapsed" Margin="2,0,0,0" />
                        <ContentPresenter Margin="14,9,12,9" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource SL.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource SL.SurfaceAlt}" />
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource SL.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruptor de segmentos (Esencial / Avanzado, tema, etc.). -->
    <Style x:Key="SL.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SL.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Back" CornerRadius="6" Padding="14,6" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource SL.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource SL.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource SL.OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SL.SegmentHost" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SL.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SL.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- Tarjeta seleccionable (plantillas, posiciones, perfiles). -->
    <Style x:Key="SL.ChoiceCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SL.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Back" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1.5"
                            Background="{DynamicResource SL.SurfaceAlt}" BorderBrush="{DynamicResource SL.Stroke}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource SL.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource SL.Accent}" />
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource SL.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SL.AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SL.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" CornerRadius="6" Background="{DynamicResource SL.Accent}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Back" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Back" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SL.SubtleButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SL.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" CornerRadius="6" BorderThickness="1" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource SL.SurfaceAlt}" BorderBrush="{DynamicResource SL.Stroke}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource SL.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Back" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SL.IconButton" TargetType="Button" BasedOn="{StaticResource SL.SubtleButton}">
        <Setter Property="FontFamily" Value="{StaticResource SL.IconFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
</ResourceDictionary>
